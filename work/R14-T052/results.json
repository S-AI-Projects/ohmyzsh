    {
      "test_id": "pipi_invalid_combination_user_prefix",
      "description": "pipi rejects documented mutually exclusive combination (--user and --prefix)",
      "mode": "pip_mode",
      "alias": "pipi",
      "inputs": {
        "args": [
          "--user",
          "--prefix",
          "/opt/custom",
          "requests"
        ]
      },
      "expected": {
        "command": "pip",
        "args": [
          "install",
          "--user",
          "--prefix",
          "/opt/custom",
          "requests"
        ],
        "status": 1
      },
      "actual": {
        "command": "pip",
        "args": [
          "install",
          "--user",
          "--prefix",
          "/opt/custom",
          "requests"
        ],
        "status": 1,
        "stderr": "ERROR: Can not combine '--user' and '--prefix' as they imply different installation locations\n"
      },
      "status": "PASS",
      "errors": []
    },
