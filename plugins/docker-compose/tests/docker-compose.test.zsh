#!/usr/bin/env zsh

emulate -LR zsh

# Ensure aliases are parsed and expanded for testing
setopt aliases

# Resolve repository and plugin paths
local plugin_file="${0:A:h:h}/docker-compose.plugin.zsh"
if [[ ! -f "$plugin_file" ]]; then
  print -u2 -r -- "FAIL: Cannot find docker-compose.plugin.zsh at $plugin_file"
  exit 1
fi

local test_dir=$(mktemp -d) || exit 1
trap 'command rm -rf -- "$test_dir"' EXIT INT TERM

# Ensure isolation: point ZDOTDIR to temp directory and ZSH to checkout
export ZDOTDIR="$test_dir/zdotdir"
mkdir -p "$ZDOTDIR"
export ZSH="${ZSH:-${0:A:h:h:h:h}}"

# Ensure host Python (Homebrew, pyenv, system) is accessible
# without exposing any host docker or docker-compose binaries to PATH
local host_tools="$test_dir/host_tools"
mkdir -p "$host_tools"
local host_python="${PYTHON_BIN:-${commands[python3]:-$(command -v python3 2>/dev/null)}}"
if [[ -n "$host_python" && -x "$host_python" ]]; then
  ln -sf "$host_python" "$host_tools/python3"
  ln -sf "$host_python" "$host_tools/python"
fi

# Create isolated bin directories for each mode
local bin_legacy="$test_dir/bin_legacy"
local bin_modern="$test_dir/bin_modern"
local bin_broken="$test_dir/bin_broken"
mkdir -p "$bin_legacy" "$bin_modern" "$bin_broken"

# Create mock stub executable
cat << 'EOF' > "$test_dir/mock_stub"
#!/usr/bin/env python3
import sys, json, os

log_file = os.environ.get("STUB_CALL_LOG")
status = int(os.environ.get("STUB_EXIT_STATUS", "0"))

if log_file:
    data = {
        "command": os.path.basename(sys.argv[0]),
        "args": sys.argv[1:],
    }
    with open(log_file, "w", encoding="utf-8") as f:
        json.dump(data, f)

if "STUB_STDOUT" in os.environ:
    sys.stdout.write(os.environ["STUB_STDOUT"])
if "STUB_STDERR" in os.environ:
    sys.stderr.write(os.environ["STUB_STDERR"])

sys.exit(status)
EOF
chmod +x "$test_dir/mock_stub"

# Set up legacy mode: docker-compose stub executable on PATH
ln -s "$test_dir/mock_stub" "$bin_legacy/docker-compose"

# Set up modern mode: docker stub executable on PATH, docker-compose absent
ln -s "$test_dir/mock_stub" "$bin_modern/docker"

# Set up broken symlink mode: docker stub present, docker-compose points to nonexistent target
ln -s "$test_dir/mock_stub" "$bin_broken/docker"
ln -s "$test_dir/nonexistent_target" "$bin_broken/docker-compose"

# Create assertion evaluator helper
cat << 'EOF' > "$test_dir/assert_test.py"
#!/usr/bin/env python3
import sys, json, os

(
    _, call_log, state_log, test_id, desc, mode, alias_name,
    exp_alias, exp_cmd, exp_status_str, exp_args_json, in_args_json,
    out_json_file
) = sys.argv[:13]

errors = []

# Validate state log
dccmd_status = "unknown"
actual_alias = ""
actual_status = -1

if not os.path.exists(state_log):
    errors.append("state log not generated by test execution")
else:
    with open(state_log, "r", encoding="utf-8") as f:
        lines = [l.rstrip("\r\n") for l in f]
    if len(lines) >= 1:
        dccmd_status = lines[0]
    if len(lines) >= 2:
        actual_alias = lines[1]
    if len(lines) >= 3:
        try:
            actual_status = int(lines[2])
        except ValueError:
            actual_status = -1

if dccmd_status != "unset":
    errors.append(f"dccmd was not unset after sourcing (was: {dccmd_status})")

if actual_alias != exp_alias:
    errors.append(f"alias {alias_name} defined as '{actual_alias}', expected '{exp_alias}'")

expected_status = int(exp_status_str)
if actual_status != expected_status:
    errors.append(f"exit status was {actual_status}, expected {expected_status}")

# Validate call log
actual_cmd = ""
actual_args = []
if not os.path.exists(call_log):
    errors.append("stub was not invoked (missing call log)")
else:
    with open(call_log, "r", encoding="utf-8") as f:
        call_data = json.load(f)
    actual_cmd = call_data.get("command", "")
    actual_args = call_data.get("args", [])

if actual_cmd != exp_cmd:
    errors.append(f"invoked command was '{actual_cmd}', expected '{exp_cmd}'")

expected_args = json.loads(exp_args_json)
if actual_args != expected_args:
    errors.append(f"arguments were {actual_args}, expected {expected_args}")

passed = len(errors) == 0
input_args = json.loads(in_args_json)

if out_json_file:
    record = {
        "test_id": test_id,
        "description": desc,
        "mode": mode,
        "alias": alias_name,
        "status": "PASS" if passed else "FAIL",
        "inputs": {
            "alias": alias_name,
            "args": input_args,
        },
        "expected": {
            "alias": exp_alias,
            "command": exp_cmd,
            "args": expected_args,
            "status": expected_status,
            "dccmd_unset": True,
        },
        "actual": {
            "alias": actual_alias,
            "command": actual_cmd,
            "args": actual_args,
            "status": actual_status,
            "dccmd_unset": dccmd_status == "unset",
        },
        "errors": errors,
    }
    with open(out_json_file, "a", encoding="utf-8") as f:
        f.write(json.dumps(record) + "\n")

if passed:
    print(f"PASS: {test_id} - {desc}")
    sys.exit(0)
else:
    print(f"FAIL: {test_id} - {desc}", file=sys.stderr)
    for err in errors:
        print(f"  - {err}", file=sys.stderr)
    sys.exit(1)
EOF
chmod +x "$test_dir/assert_test.py"

typeset -i tests=0 failures=0
local out_json_file="${RECORD_JSON:-}"

run_alias_test() {
  local test_id="$1"
  local desc="$2"
  local mode="$3"
  local alias_name="$4"
  local exp_alias="$5"
  local exp_cmd="$6"
  local exp_status="$7"
  local mock_status="$8"
  local in_args_json="$9"
  local exp_args_json="${10}"

  local bin_path
  case "$mode" in
    legacy) bin_path="$bin_legacy" ;;
    modern) bin_path="$bin_modern" ;;
    broken) bin_path="$bin_broken" ;;
    *) print -u2 -r -- "Invalid mode: $mode"; exit 1 ;;
  esac

  local call_log="$test_dir/call_${test_id}.log"
  local state_log="$test_dir/state_${test_id}.log"
  command rm -f "$call_log" "$state_log"

  (
    # Isolate PATH with mode-specific bin first, host tools (python), then system fallbacks
    export PATH="$bin_path:$host_tools:/usr/bin:/bin"
    rehash
    setopt aliases

    # Source the plugin in this isolated shell
    source "$plugin_file"

    local dccmd_state="unset"
    [[ -n "${dccmd+set}" ]] && dccmd_state="set:${dccmd}"

    local actual_alias_val="$aliases[$alias_name]"

    export STUB_CALL_LOG="$call_log"
    export STUB_EXIT_STATUS="$mock_status"

    # Expand arguments from json string into array
    local -a parsed_args
    if [[ "$in_args_json" != "[]" ]]; then
      # Convert JSON array to arguments safely using host python
      local -a raw_in_args
      raw_in_args=("${(@f)$("${host_python:-python3}" -c "import sys, json; [print(x) for x in json.loads(sys.argv[1])]" "$in_args_json")}")
      parsed_args=("${raw_in_args[@]}")
    fi

    local eval_cmd="$alias_name"
    if (( ${#parsed_args} > 0 )); then
      eval_cmd="$alias_name ${(j: :)${(@q)parsed_args}}"
    fi

    eval "$eval_cmd"
    local eval_status=$?

    print -r -- "$dccmd_state" > "$state_log"
    print -r -- "$actual_alias_val" >> "$state_log"
    print -r -- "$eval_status" >> "$state_log"
  )

  "${host_python:-python3}" "$test_dir/assert_test.py" \
    "$call_log" "$state_log" "$test_id" "$desc" "$mode" "$alias_name" \
    "$exp_alias" "$exp_cmd" "$exp_status" "$exp_args_json" "$in_args_json" \
    "$out_json_file"

  local test_result=$?
  (( tests++ ))
  if (( test_result != 0 )); then
    (( failures++ ))
  fi
}

# ==============================================================================
# Test Cases: Legacy Mode (docker-compose available on PATH)
# ==============================================================================

# dco entry point
run_alias_test "legacy_dco_noargs" \
  "Legacy dco without arguments invokes docker-compose with no args" \
  "legacy" "dco" "docker-compose" "docker-compose" 0 0 \
  '[]' '[]'

run_alias_test "legacy_dco_with_args" \
  "Legacy dco forwards arguments and preserves spaces/quoting" \
  "legacy" "dco" "docker-compose" "docker-compose" 0 0 \
  '["up", "-d", "web service"]' '["up", "-d", "web service"]'

# dcb entry point
run_alias_test "legacy_dcb_noargs" \
  "Legacy dcb without arguments invokes docker-compose build" \
  "legacy" "dcb" "docker-compose build" "docker-compose" 0 0 \
  '[]' '["build"]'

run_alias_test "legacy_dcb_with_args" \
  "Legacy dcb forwards build args with spaces" \
  "legacy" "dcb" "docker-compose build" "docker-compose" 0 0 \
  '["--build-arg", "KEY=value with spaces"]' '["build", "--build-arg", "KEY=value with spaces"]'

# dcc entry point
run_alias_test "legacy_dcc_noargs" \
  "Legacy dcc without arguments invokes docker-compose config" \
  "legacy" "dcc" "docker-compose config" "docker-compose" 0 0 \
  '[]' '["config"]'

run_alias_test "legacy_dcc_with_args" \
  "Legacy dcc forwards config options with spaces" \
  "legacy" "dcc" "docker-compose config" "docker-compose" 0 0 \
  '["--file", "compose test.yml", "--services"]' '["config", "--file", "compose test.yml", "--services"]'

# exit status propagation
run_alias_test "legacy_dco_exit_status_propagation" \
  "Legacy dco propagates non-zero exit status from underlying command" \
  "legacy" "dco" "docker-compose" "docker-compose" 42 42 \
  '["ps"]' '["ps"]'

# ==============================================================================
# Test Cases: Modern Mode (docker-compose absent, docker compose fallback)
# ==============================================================================

# dco entry point
run_alias_test "modern_dco_noargs" \
  "Modern dco without arguments invokes docker compose" \
  "modern" "dco" "docker compose" "docker" 0 0 \
  '[]' '["compose"]'

run_alias_test "modern_dco_with_args" \
  "Modern dco forwards arguments preserving spaces" \
  "modern" "dco" "docker compose" "docker" 0 0 \
  '["up", "-d", "web service"]' '["compose", "up", "-d", "web service"]'

# dcb entry point
run_alias_test "modern_dcb_noargs" \
  "Modern dcb without arguments invokes docker compose build" \
  "modern" "dcb" "docker compose build" "docker" 0 0 \
  '[]' '["compose", "build"]'

run_alias_test "modern_dcb_with_args" \
  "Modern dcb forwards build args preserving spaces" \
  "modern" "dcb" "docker compose build" "docker" 0 0 \
  '["--build-arg", "APP_ENV=local dev"]' '["compose", "build", "--build-arg", "APP_ENV=local dev"]'

# dcc entry point
run_alias_test "modern_dcc_noargs" \
  "Modern dcc without arguments invokes docker compose config" \
  "modern" "dcc" "docker compose config" "docker" 0 0 \
  '[]' '["compose", "config"]'

run_alias_test "modern_dcc_with_args" \
  "Modern dcc forwards config options preserving spaces" \
  "modern" "dcc" "docker compose config" "docker" 0 0 \
  '["--file", "docker compose.yml", "--resolve-image-digests"]' '["compose", "config", "--file", "docker compose.yml", "--resolve-image-digests"]'

# exit status propagation
run_alias_test "modern_dcb_exit_status_propagation" \
  "Modern dcb propagates non-zero exit status from underlying command" \
  "modern" "dcb" "docker compose build" "docker" 7 7 \
  '[]' '["compose", "build"]'

# ==============================================================================
# Test Cases: Broken Symlink Fallback Mode
# ==============================================================================

# dco entry point
run_alias_test "broken_symlink_dco_fallback" \
  "Broken symlink docker-compose safely falls back to docker compose" \
  "broken" "dco" "docker compose" "docker" 0 0 \
  '["ps"]' '["compose", "ps"]'

# dcb entry point
run_alias_test "broken_symlink_dcb_fallback" \
  "Broken symlink docker-compose safely falls back to docker compose build" \
  "broken" "dcb" "docker compose build" "docker" 0 0 \
  '[]' '["compose", "build"]'

# dcc entry point
run_alias_test "broken_symlink_dcc_fallback" \
  "Broken symlink docker-compose safely falls back to docker compose config" \
  "broken" "dcc" "docker compose config" "docker" 0 0 \
  '["--services"]' '["compose", "config", "--services"]'

# exit status propagation
run_alias_test "broken_symlink_dcc_exit_status_propagation" \
  "Broken symlink mode propagates non-zero exit status" \
  "broken" "dcc" "docker compose config" "docker" 1 1 \
  '[]' '["compose", "config"]'

# ==============================================================================
# Summary and Zero-Case Rejection
# ==============================================================================

if (( tests == 0 )); then
  print -u2 -r -- "FAIL: Zero tests were executed!"
  exit 1
fi

print -r -- "$tests tests, $failures failures"
(( failures == 0 ))
